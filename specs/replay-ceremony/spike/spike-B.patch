+import { useEffect, useRef, useState } from 'react';
+import { nextStop, reanchor, seekClock, tickClock } from '../../lib/ceremony/clock';
+import type { Jump, Showing } from '../../lib/ceremony/types';
+
+/** The clock's time, read against the telling it was last read with. */
+type Clock = { epoch: number; ms: number; held: boolean; ended: boolean; showing: Showing | null; aimed: number | null; jump: Jump | null };
+
+/**
+ * SPIKE B: `useCeremonyClock` with the time kept outside React. One requestAnimationFrame loop owns the time; each
+ * frame it ticks (`tickClock`, as before) and hands the time to `onFrame`, which draws it (the map, the stage) and
+ * answers with a key of what the screen itself shows. React state is set, so the screen renders, only when that key
+ * changes, or on a press (Hold, Next) or the end. Everything else is the hook it replaces.
+ */
+export function useCeremonyLoop(o: { epoch: number; running: boolean; paused: boolean; showing: Showing | null; onEnd: () => void; onFrame: (ms: number, jump: Jump | null) => string }) {
+  const fresh = (epoch: number, showing: Showing | null): Clock => ({ epoch, ms: 0, held: false, ended: false, showing, aimed: null, jump: null });
+  const against = (c: Clock, epoch: number, showing: Showing | null): Clock => {
+    if (c.epoch !== epoch) return fresh(epoch, showing);
+    if (c.showing && showing && c.showing !== showing) return { ...c, ms: reanchor(c.showing, showing, c.ms), showing, aimed: null, jump: null };
+    return c.showing === showing ? c : { ...c, showing };
+  };
+  const [state, setState] = useState<Clock>(() => fresh(o.epoch, o.showing));
+  const now = useRef<Clock>(fresh(o.epoch, o.showing));
+  const last = useRef(0);
+  const live = useRef({ epoch: o.epoch, paused: o.paused, showing: o.showing, onEnd: o.onEnd, onFrame: o.onFrame });
+  useEffect(() => {
+    live.current = { epoch: o.epoch, paused: o.paused, showing: o.showing, onEnd: o.onEnd, onFrame: o.onFrame };
+  });
+  /** What was last drawn, and the screen's key for it. */
+  const drawn = useRef<{ ms: number; showing: Showing | null; jump: Jump | null; key: string } | null>(null);
+  const current = (): Clock => against(now.current, live.current.epoch, live.current.showing);
+  const canNextAt = (c: Clock) => !c.ended && !!c.showing && nextStop(c.showing.stops, c.ms, c.aimed) != null;
+  /** Draws the clock's time if it moved, and renders the screen if what it shows changed (or `render`). */
+  const show = (c: Clock, render: boolean) => {
+    now.current = c;
+    const d = drawn.current;
+    let key = d?.key ?? null;
+    if (!d || d.ms !== c.ms || d.showing !== c.showing || d.jump !== c.jump) {
+      key = `${live.current.onFrame(c.ms, c.jump)}|${canNextAt(c)}`;
+      drawn.current = { ms: c.ms, showing: c.showing, jump: c.jump, key };
+    }
+    if (render || key !== (d?.key ?? null)) setState(c);
+  };
+  useEffect(() => {
+    if (!o.running) return;
+    last.current = Date.now();
+    let raf = 0;
+    const loop = () => {
+      raf = requestAnimationFrame(loop);
+      (globalThis as { __perf?: Record<string, number> }).__perf && ((globalThis as unknown as { __perf: Record<string, number> }).__perf['replay:loop'] = ((globalThis as unknown as { __perf: Record<string, number> }).__perf['replay:loop'] ?? 0) + 1);
+      const t = Date.now();
+      const dt = t - last.current;
+      last.current = t;
+      const c = current();
+      const { paused, showing, onEnd } = live.current;
+      const { clock, end } = tickClock(c, dt, { paused, total: showing?.total ?? 0 });
+      const next = { ...c, ...clock, ended: c.ended || end };
+      show(next, next.ended !== c.ended || c !== now.current);
+      if (end && !c.ended) onEnd();
+    };
+    raf = requestAnimationFrame(loop);
+    return () => {
+      cancelAnimationFrame(raf);
+      drawn.current = null;
+    };
+    // The loop reads the rest through refs; only starting and stopping it matters here.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [o.running]);
+  const shown = against(state, o.epoch, o.showing);
+  return {
+    /** The time at the screen's last render: only what the screen itself shows may be read from it. */
+    ms: shown.ms,
+    held: shown.held,
+    jump: shown.jump,
+    canNext: canNextAt(shown),
+    toggleHold: () => {
+      const c = current();
+      show({ ...c, held: !c.held }, true);
+    },
+    next: () => {
+      const c = current();
+      const to = c.showing && !c.ended ? nextStop(c.showing.stops, c.ms, c.aimed) : null;
+      if (to) show({ ...c, ...seekClock(c, to.ms), aimed: to.t0, jump: { from: c.ms, at: to.ms } }, true);
+    },
+  };
+}
