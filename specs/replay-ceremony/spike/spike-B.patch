+import { useSyncExternalStore } from 'react';
+import type { Frame } from '../../lib/ceremony/types';
+import type { StageCtx } from './layout';
+import { Stage } from './Stage';
+
+/** SPIKE B: the frame on stage, kept outside the screen: the replay's loop writes it, only `StageLive` reads it. */
+export type StageStore = { get(): Frame | null; set(f: Frame | null, tag?: unknown): void; subscribe(fn: () => void): () => void };
+
+export function createStageStore(): StageStore {
+  let frame: Frame | null = null;
+  let sig = '';
+  let last: unknown = null;
+  const subs = new Set<() => void>();
+  return {
+    get: () => frame,
+    // A frame that would draw the stage as it stands is not handed on: the stage renders only when it changes.
+    set(f, tag) {
+      const s = f ? stageSig(f) : '';
+      if (s === sig && tag === last && (f == null) === (frame == null)) return;
+      sig = s;
+      last = tag;
+      frame = f;
+      for (const fn of subs) fn();
+    },
+    subscribe(fn) {
+      subs.add(fn);
+      return () => {
+        subs.delete(fn);
+      };
+    },
+  };
+}
+
+/** Everything the stage draws from, as one string: the clock by its minute, each overlay's numbers, and the camera only while an overlay is placed by it. */
+function stageSig(f: Frame): string {
+  let s = `${f.dim}|${f.clock == null ? '' : Math.floor(f.clock / 60_000)}|${f.line ?? ''}|${f.lineOpacity}`;
+  let camera = false;
+  for (const o of f.overlays) {
+    s += `|${o.kind}:${o.key}`;
+    if (o.kind === 'bubble') s += `:${o.enter}:${o.exit}:${o.playing}:${o.progress}`;
+    else if (o.kind === 'card') {
+      s += `:${o.grow}:${o.tuck}:${o.playing}:${o.progress}:${o.fade}:${o.scroll ?? ''}:${o.shown ? o.shown.join(',') : ''}`;
+      // A card is placed from its pin only while it grows.
+      if (o.from && o.grow < 1) camera = true;
+    } else if (o.kind === 'pile') s += `:${o.captures.length}:${o.captures[o.captures.length - 1]?.id ?? ''}`;
+    else {
+      s += `:${o.opacity}:${o.text}`;
+      camera = true;
+    }
+  }
+  const c = f.camera.center;
+  if (camera && c) s += `|${c[0]},${c[1]},${f.camera.zoom}`;
+  return s;
+}
+
+/** The stage, rendered from the store at its own leaf: the screen above it does not render per frame. */
+export function StageLive({ store, ctx }: { store: StageStore; ctx: Omit<StageCtx, 'center' | 'zoom'> }) {
+  const frame = useSyncExternalStore(store.subscribe, store.get);
+  if (!frame) return null;
+  const center = frame.camera.center;
+  return <Stage frame={frame} ctx={{ ...ctx, center, zoom: center ? frame.camera.zoom ?? 0 : 0 }} />;
+}
