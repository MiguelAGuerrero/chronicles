+// SPIKE A: a time of day is worded once per minute, not on every render.
+const TIMES = new Map<number, string>();
+export const timeOf = (t: number) => {
+  const minute = Math.floor(t / 60_000);
+  let text = TIMES.get(minute);
+  if (text == null) {
+    if (TIMES.size > 500) TIMES.clear();
+    text = new Date(t).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
+    TIMES.set(minute, text);
+  }
+  return text;
+};
