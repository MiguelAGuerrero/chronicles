{
  "$comment": "The shop pack's record, as the app pins it (specs/shop-marks, SM4, SM8). Generated from chronicles-data's src schema once that exists.",
  "contractVersion": 1,
  "layer": "shops",
  "zoom": 12,
  "record": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "type": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "at": {
        "type": "array",
        "prefixItems": [
          { "type": "number", "minimum": -180, "maximum": 180 },
          { "type": "number", "minimum": -90, "maximum": 90 }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      },
      "chain": { "const": true }
    },
    "required": ["type", "name", "at"],
    "additionalProperties": false
  }
}
