{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "manifest.json as scripts/manifest.mjs writes it. Generated by `npm run contract`.",
  "contractVersion": 3,
  "type": "object",
  "required": [
    "schema",
    "regions"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "current",
          "previous"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          },
          "current": {
            "$ref": "#/$defs/file"
          },
          "previous": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/file"
            },
            "description": "Older versions still served, newest first"
          }
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "file",
        "version",
        "bounds"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^places-[a-z0-9]+-\\d{8}(?:\\.\\d+)?\\.pmtiles$",
          "description": "Beside the manifest, never a path"
        },
        "version": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "minzoom": {
          "type": "integer"
        },
        "maxzoom": {
          "type": "integer"
        },
        "bounds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[west, south, east, north]"
        },
        "blocks": {
          "type": "object",
          "description": "PP11: a hash of the places in each z8 block; a client rebuilds an area only when its block changes",
          "propertyNames": {
            "pattern": "^8/\\d+/\\d+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          }
        }
      }
    }
  }
}
