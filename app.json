{
  "expo": {
    "name": "Chronicles",
    "slug": "chronicles",
    "scheme": "chronicles",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.miguelaguerrero.chronicles",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.miguelaguerrero.chronicles",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Chronicles records the streets you walk while a walk is open, including with the screen off.",
          "locationWhenInUsePermission": "Chronicles records the streets you walk during a walk.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Chronicles takes photos that stay inside your walk.",
          "photosPermission": false,
          "microphonePermission": "Chronicles records sound with videos you take on a walk."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Chronicles records voice notes during a walk.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Chronicles uses your phone's motion to tell when you're standing still during a walk, so GPS drift doesn't move your trace."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Chronicles saves the photos and videos you choose to your library.",
          "granularPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#c2410c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
